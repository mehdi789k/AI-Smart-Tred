```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
env/

# Test coverage reports
.coverage
htmlcov/
.coverage.*

# Python dependency management
*.egg-info/
.eggs/

# Logs
*.log

# Environment files
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
build/
dist/
*.egg
*.whl

# Cache directories
.mypy_cache/
.pytest_cache/
__pycache__/
*.pyc
*.pyo
*.pyd

# OS generated files
.DS_Store
Thumbs.db
```